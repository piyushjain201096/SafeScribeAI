<Window x:Class="SafeScribe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SafeScribe AI - Local Meeting Assistant (.NET)" Height="780" Width="1120"
        Background="#0F172A" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Hardware RAM Indicator -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#6366F1" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SafeScribe AI Meeting Assistant" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#10B981" CornerRadius="12" Padding="8,3" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Local Privacy Engine (0 Cloud Data)" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHardwareInfo" Text="Scanning system hardware..." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Platform Call Detector Status Banner -->
                <Border Grid.Column="1" Background="#334155" CornerRadius="8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDetectorStatus" Text="Detector Active (Teams / Slack / Meet)" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Detection & Call Banner Notification -->
        <Border x:Name="BannerMeetingPrompt" Grid.Row="1" Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtDetectedTitle" Text="Active Meeting Detected: Teams - Q3 Review" FontSize="14" FontWeight="Bold" Foreground="#EEF2FF"/>
                        <TextBlock Text="Click Start Recording to begin local audio loopback transcription." FontSize="12" Foreground="#C7D2FE"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Accept &amp; Record" Click="BtnStartRecording_Click" Background="#6366F1" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Left = Transcripts & Controls, Right = Summaries & Action Items -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Live Transcription & Recording Controls -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <TextBlock Text="Live Audio &amp; Transcript" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRecordingTimer" Text="00:00" FontSize="14" Foreground="#10B981" FontWeight="Bold" Margin="15,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Transcript Stream Box -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtTranscript" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontSize="13" Padding="12"
                                 Text="[System Ready] Click 'Start Recording' or drag &amp; drop an audio file (.mp3, .wav, .m4a)..."/>
                    </Border>

                    <!-- Action Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnImportAudio" Content="📁 Import Audio" Click="BtnImportAudio_Click" Background="#334155" Foreground="White" FontWeight="SemiBold" Padding="12,10" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button x:Name="BtnStartRecording" Content="▶ Start Recording" Click="BtnStartRecording_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="18,10" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button x:Name="BtnStopRecording" Content="⏹ Stop &amp; Summarize" Click="BtnStopRecording_Click" IsEnabled="False" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="18,10" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel: Ollama AI Summary & Post-Summary Calendar Sync -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ollama AI Summary" FontSize="16" FontWeight="Bold" Grid.Column="0"/>
                            
                            <!-- Meeting Prompt Template Selector -->
                            <ComboBox x:Name="CmbTemplates" Grid.Column="1" Width="170" Height="26" Background="#334155" Foreground="#F8FAFC" FontSize="11" SelectedIndex="0">
                                <ComboBoxItem Content="General Meeting"/>
                                <ComboBoxItem Content="Daily Standup"/>
                                <ComboBoxItem Content="Sales Discovery"/>
                                <ComboBoxItem Content="1-on-1 Sync"/>
                                <ComboBoxItem Content="Executive Briefing"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="TxtModelStatus" Text="Using Model: llama3.2:3b (Optimized for 8GB RAM)" FontSize="12" Foreground="#6366F1" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Summary Display Area -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtSummary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" FontSize="13" Padding="12"
                                 Text="Summary will appear here after recording finishes..."/>
                    </Border>

                    <!-- Post-Summary Action Item Sync & Calendar Buttons -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="📅 Export &amp; Calendar Integration" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnGoogleCalendar" Content="Google Cal" Click="BtnGoogleCalendar_Click" Background="#2563EB" Foreground="White" FontSize="11" Padding="8,5" BorderThickness="0" Margin="0,0,4,4" Cursor="Hand"/>
                                <Button x:Name="BtnOutlookCalendar" Content="Outlook" Click="BtnOutlookCalendar_Click" Background="#0284C7" Foreground="White" FontSize="11" Padding="8,5" BorderThickness="0" Margin="0,0,4,4" Cursor="Hand"/>
                                <Button x:Name="BtnExportIcs" Content=".ICS File" Click="BtnExportIcs_Click" Background="#475569" Foreground="White" FontSize="11" Padding="8,5" BorderThickness="0" Margin="0,0,4,4" Cursor="Hand"/>
                                <Button x:Name="BtnExportObsidian" Content="Obsidian" Click="BtnExportObsidian_Click" Background="#7C3AED" Foreground="White" FontSize="11" Padding="8,5" BorderThickness="0" Margin="0,0,4,4" Cursor="Hand"/>
                                <Button x:Name="BtnExportSlack" Content="Copy Slack" Click="BtnExportSlack_Click" Background="#059669" Foreground="White" FontSize="11" Padding="8,5" BorderThickness="0" Margin="0,0,4,4" Cursor="Hand"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Model Provider Settings Trigger -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="SafeScribe AI v1.0 (.NET 10 Core)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Content="⚙ Model Provider Settings" Click="BtnSettings_Click" Background="Transparent" Foreground="#94A3B8" FontSize="11" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
