<Window x:Class="SafeScribe.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeScribe Widget" Height="50" Width="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual" ResizeMode="NoResize">

    <Border Background="#1E293B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="25" Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0" x:Name="DotRecording" Width="12" Height="12" Fill="#10B981" Margin="4,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="SafeScribe Active" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="BtnClose" Content="✕" Click="BtnClose_Click" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="10" Padding="4" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
