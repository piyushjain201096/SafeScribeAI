<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SafeScribe.UI.Avalonia.MainWindow"
        Title="SafeScribe AI — Privacy-First Meeting Assistant (.NET 10 Avalonia UI)"
        Width="1050" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,12" CornerRadius="0,0,12,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#6366F1" CornerRadius="8">
                        <TextBlock Text="🎙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SafeScribe AI" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="100% Local Meeting Transcription &amp; AI Summaries" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TxtHardwareInfo" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Foreground="#A855F7" FontSize="12" FontWeight="SemiBold"/>

                <Border Grid.Column="2" Background="#065F46" CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#34D399"/>
                        <TextBlock Text="Local Ollama Active" Foreground="#34D399" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Controls Toolbar -->
        <Border Grid.Row="1" Background="#1E293B" Margin="16,12" Padding="16" CornerRadius="12">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <Button x:Name="BtnStartRecording" Grid.Column="0" Click="BtnStartRecording_Click"
                        Background="#10B981" Foreground="White" Padding="16,10" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▶" VerticalAlignment="Center"/>
                        <TextBlock Text="Start Recording" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnStopRecording" Grid.Column="1" Click="BtnStopRecording_Click" IsEnabled="False"
                        Background="#EF4444" Foreground="White" Padding="16,10" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⏹" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop &amp; Summarize" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnImportAudio" Grid.Column="2" Click="BtnImportAudio_Click"
                        Background="#3B82F6" Foreground="White" Padding="16,10" CornerRadius="8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📁" VerticalAlignment="Center"/>
                        <TextBlock Text="Import Audio File (WAV/MP3)" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="BtnExportObsidian_Click" Background="#475569" Foreground="White" Padding="12,8" CornerRadius="6">
                        <TextBlock Text="Obsidian MD"/>
                    </Button>
                    <Button Click="BtnExportSlack_Click" Background="#475569" Foreground="White" Padding="12,8" CornerRadius="6">
                        <TextBlock Text="Copy for Slack/Teams"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Split View -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="16,0,16,16">
            <!-- Left Pane: Transcript -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="🗣️ Diarized Live Transcript" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1">
                        <TextBox x:Name="TxtTranscript" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Pane: AI Summary -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="📋 Local Ollama AI Summary" FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1">
                        <TextBox x:Name="TxtSummary" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" FontFamily="Segoe UI, Inter, sans-serif"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
